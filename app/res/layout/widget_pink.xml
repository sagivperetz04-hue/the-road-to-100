<?xml version="1.0" encoding="utf-8"?>
<!-- Timer widget, pink theme (unicorns, sunshine and rainbows). TimerWidget.java fills the texts; the samples here
     are what the widget picker shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg_pink"
    android:layoutDirection="rtl">

    <ImageView android:layout_width="230dp" android:layout_height="115dp" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="-34dp" android:alpha="0.55" android:src="@drawable/w_rainbow" android:importantForAccessibility="no" />
    <ImageView android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="top|left"
        android:layout_marginLeft="-14dp" android:layout_marginTop="-14dp" android:src="@drawable/w_sun" android:importantForAccessibility="no" />
    <ImageView android:layout_width="46dp" android:layout_height="26dp" android:layout_gravity="top|left"
        android:layout_marginLeft="30dp" android:layout_marginTop="6dp" android:src="@drawable/w_cloud" android:importantForAccessibility="no" />
    <ImageView android:layout_width="38dp" android:layout_height="21dp" android:layout_gravity="bottom|right"
        android:layout_marginRight="10dp" android:layout_marginBottom="4dp" android:alpha="0.9" android:src="@drawable/w_cloud" android:importantForAccessibility="no" />
    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp" android:src="@drawable/w_sparkle" android:importantForAccessibility="no" />
    <ImageView android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="bottom|left"
        android:layout_marginLeft="12dp" android:layout_marginBottom="14dp" android:src="@drawable/w_sparkle" android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.44"
            android:gravity="center_vertical|start"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🦄" android:textSize="20sp"
                    android:layout_marginEnd="4dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="נשארו" android:textColor="#FFB0306E" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/w_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="42" android:textColor="#FFE0337F" android:textSize="44sp" android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false" android:maxLines="1" android:shadowColor="#66FFFFFF" android:shadowDy="2" android:shadowRadius="1" />
                <TextView android:id="@+id/w_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:layout_marginBottom="6dp"
                    android:text="ימים" android:textColor="#FFB0306E" android:textSize="16sp" android:fontFamily="sans-serif-black" />
            </LinearLayout>

            <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ועוד 5 ימים" android:textColor="#FF9C4A7A" android:textSize="12sp" android:maxLines="1" android:visibility="gone" />

            <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="7dp"
                android:max="1000" android:progress="620" android:mirrorForRtl="true" android:progressDrawable="@drawable/wprog_pink" />

            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="המבחן הגדול" android:textColor="#FF7A2E5C" android:textSize="13sp"
                android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_sentence_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.56"
            android:background="@drawable/wbubble_pink"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView android:id="@+id/w_sentence" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="כל מדרגה קטנה היא עדיין צעד למעלה."
                android:textColor="#FF6B2A55" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:lineSpacingMultiplier="1.1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
